 # All-pairs sweep
 # ---------------------------------------------------------------------------
 
+def check_run_config(flame, kw: dict) -> dict:
+    """B3 (AUDIT.md): a motor csendes viselkedeseinek kimondasa a sweep elott.
+
+    A `flame_pure` nem naplóz semmit: a hataron kivuli parametereket NEM
+    validalja, hanem CSENDBEN levagja (`ngram` -> [2,8], `n_out` -> [0,2],
+    `min_chain_words` -> >=1, `fuzz_threshold` -> [0.5,1.0]), a hianyzo BPE
+    modellt pedig ures merge-listaval helyettesiti.  Egyik sem valtoztat a
+    talalathalmazon (a BPE csak a `score`-t mozditja, l. AUDIT V1), de mindketto
+    ertelmezhetetlenne teszi a riportot, ha eszrevetlen marad.
+
+    Additiv: csak figyelmeztet es meta-adatot ad vissza, a rekordokat nem
+    erinti."""
+    warn = []
+    eff = {
+        "ngram": max(2, min(8, int(kw.get("ngram", flame.NGRAM)))),
+        "n_out": max(0, min(2, int(kw.get("n_out", flame.N_OUT)))),
+        "min_chain_words": max(1, int(kw.get("min_chain_words",
+                                             flame.MIN_CHAIN_WORDS))),
+        "fuzz_threshold": max(0.5, min(1.0, float(kw.get("fuzz_threshold",
+                                                         flame.FUZZ_THRESHOLD)))),
+    }
+    for k, v in eff.items():
+        if k in kw and kw[k] != v:
+            warn.append(f"{k}={kw[k]} -> a motor {v}-t hasznal (csendes clamp)")
+    try:
+        from flame import bpe_pure
+        trained = bool(bpe_pure.load())
+        n_merges = len(bpe_pure.load())
+    except Exception:
+        trained, n_merges = False, 0
+    if not trained:
+        warn.append("nincs betoltott BPE modell -> a `score` mezo NEM a "
+                    "jelentett futas skalajan all (a talalathalmaz valtozatlan)")
+    for w in warn:
+        print(f"  [FIGYELEM] {w}")
+    return {"effective": eff, "bpe_trained": trained, "bpe_merges": n_merges,
+            "max_candidates": kw.get("max_candidates"),
+            "cap_words": flame.CAP_WORDS, "cap_sections": flame.CAP_SECTIONS}
+
+
+def write_run_meta(meta: dict, works: list[dict], path: Path) -> None:
+    """B2 (AUDIT.md): a futas parameterei a talalatok MELLE, sidecar fajlba.
+
+    A `text_reuse_matches.ndjson` egyetlen rekordja sem hordoz futas-metaadatot,
+    ezert a `max_candidates` erteket utolag csak kozvetve lehetett visszanyerni
+    (l. AUDIT 2. pont).  Ez a sidecar additiv: a rekordok mezoi valtozatlanok."""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    engine_src = BUNDLED_FLAME_DIR / "flame" / "flame_pure.py"
+    payload = dict(meta)
+    payload["generated"] = time.strftime("%Y-%m-%dT%H:%M:%S")
+    payload["engine_sha256"] = (
+        hashlib.sha256(engine_src.read_bytes()).hexdigest()
+        if engine_src.is_file() else None)
+    payload["corpus_ref"] = corpus_ref()
+    payload["works"] = [{"tlg_id": w["tlg_id"], "era": w.get("era", ""),
+                         "author": w.get("author", "")} for w in works]
+    path.write_text(json.dumps(payload, ensure_ascii=False, indent=2),
+                    encoding="utf-8")
+
+
